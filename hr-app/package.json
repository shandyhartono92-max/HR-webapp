{
  "name": "hr-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate && prisma generate --config prisma.accounts.config.ts",
    "db:migrate": "prisma migrate dev",
    "db:migrate:accounts": "prisma migrate deploy --config prisma.accounts.config.ts",
    "db:migrate:sites": "tsx --conditions=react-server --env-file=.env scripts/migrate-sites.mts",
    "backup": "tsx --conditions=react-server --env-file=.env scripts/backup.mts",
    "db:seed": "prisma db seed",
    "retention": "tsx --conditions=react-server scripts/retention.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@prisma/adapter-mariadb": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "exceljs": "4.4.0",
    "jose": "^6.2.14",
    "mammoth": "^1.13.0",
    "next": "16.4.3",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.9",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prisma": "^7.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  }
}
