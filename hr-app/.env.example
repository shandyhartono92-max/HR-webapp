# Copy to .env and fill in. Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# MariaDB / MySQL (XAMPP on this PC: database portal_hr, user portal_hr)
DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/portal_hr"
# Only for `npx prisma migrate dev` (an empty database the user may reset)
SHADOW_DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/portal_hr_shadow"
SESSION_SECRET=""
ENCRYPTION_KEY=""

# Development seed only
SEED_ADMIN_EMAIL="admin@perusahaan.local"
SEED_ADMIN_PASSWORD=""

# AI CV screening (optional). Without it, screening is switched off.
ANTHROPIC_API_KEY=""

# Database connections kept open by the app (default 5)
# DATABASE_POOL_MAX=5

# Letterhead and signatory printed on letters (replace with your company's details)
COMPANY_NAME=""
COMPANY_ADDRESS=""
COMPANY_CITY=""
LETTER_SIGNATORY_NAME=""
LETTER_SIGNATORY_TITLE=""
# Optional: LETTER_NUMBER_FORMAT=""

# Years after an employee's exit date before their personal data is anonymised (default 10,
# the tax record period of UU KUP Pasal 28). See npm run retention.
# EMPLOYEE_RETENTION_YEARS=10
