# Copy to .env and fill in. Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/hr_app"
SESSION_SECRET=""
ENCRYPTION_KEY=""

# Development seed only
SEED_ADMIN_EMAIL="admin@perusahaan.local"
SEED_ADMIN_PASSWORD=""

# AI CV screening (optional). Without it, screening is switched off.
ANTHROPIC_API_KEY=""

# Set to 1 only when using `npx prisma dev` locally
# DATABASE_POOL_MAX=1

# Letterhead and signatory printed on letters (replace with your company's details)
COMPANY_NAME=""
COMPANY_ADDRESS=""
COMPANY_CITY=""
LETTER_SIGNATORY_NAME=""
LETTER_SIGNATORY_TITLE=""
# Optional: LETTER_NUMBER_FORMAT=""
