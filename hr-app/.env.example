# Copy to .env and fill in. Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# MariaDB / MySQL (XAMPP on this PC: database portal_hr, user portal_hr)
DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/portal_hr"
# Only for `npx prisma migrate dev` (an empty database the user may reset)
SHADOW_DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/portal_hr_shadow"
SESSION_SECRET=""
ENCRYPTION_KEY=""

# Locations: one database per location (same schema), one shared accounts database.
# Each code in SITES needs DATABASE_URL_<CODE>; label and company details are optional
# (letters show placeholders until they are filled in). See src/lib/sites.ts.
SITES="batam,jakarta"
SITE_LABEL_BATAM="Batam"
DATABASE_URL_BATAM="mysql://USER:PASSWORD@127.0.0.1:3306/portal_hr"
COMPANY_NAME_BATAM=""
COMPANY_ADDRESS_BATAM=""
COMPANY_CITY_BATAM=""
LETTER_SIGNATORY_NAME_BATAM=""
LETTER_SIGNATORY_TITLE_BATAM=""
SITE_LABEL_JAKARTA="Jakarta"
DATABASE_URL_JAKARTA="mysql://USER:PASSWORD@127.0.0.1:3306/portal_hr_jakarta"
COMPANY_NAME_JAKARTA=""
COMPANY_ADDRESS_JAKARTA=""
COMPANY_CITY_JAKARTA=""
LETTER_SIGNATORY_NAME_JAKARTA=""
LETTER_SIGNATORY_TITLE_JAKARTA=""
# Logins and per-location access (portal_hr_akun); the shadow one only for migrate dev
ACCOUNTS_DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/portal_hr_akun"
ACCOUNTS_SHADOW_DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/portal_hr_akun_shadow"
# Folder for npm run backup (outside the repo: the dumps hold personal data)
BACKUP_DIR=""

# Development seed only
SEED_ADMIN_EMAIL="admin@perusahaan.local"
SEED_ADMIN_PASSWORD=""

# AI CV screening (optional). Without it, screening is switched off.
ANTHROPIC_API_KEY=""

# Database connections kept open by the app (default 5)
# DATABASE_POOL_MAX=5

# Letterhead and signatory: per location, see COMPANY_*_<CODE> above
# Optional: LETTER_NUMBER_FORMAT=""

# Years after an employee's exit date before their personal data is anonymised (default 10,
# the tax record period of UU KUP Pasal 28). See npm run retention.
# EMPLOYEE_RETENTION_YEARS=10
